# Company deployment (IMT-Support account, us-west-2). Matches the context
# the original deploy.sh hardcoded; see docs/ARCHITECTURE.md §1.
AWS_PROFILE=ams-admin
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=721082559106
STACK=AmsDashboardStack
ENVIRONMENT=prod
PUBLIC_ALB=true
# Plain HTTP until the ACM cert for ams-dashboard.infomagnetics.com is wired up.
ALLOW_PUBLIC_HTTP=true
ACM_CERT_ARN=
DOMAIN_NAME=
HOSTED_ZONE_ID=
HOSTED_ZONE_NAME=
JIRA_SYNC_ENABLED=true
# Aurora keeps its 0.5 ACU floor in prod (no auto-pause latency for the team).
AURORA_AUTO_PAUSE_MINUTES=0
API_DESIRED_COUNT=1
