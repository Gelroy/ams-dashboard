# Customer Portal skunkworks: Tony's personal account, synthetic data only.
# See docs/CUSTOMER_PORTAL.md. Never point this at the company account.
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=465362304148
STACK=AmsDashboardPersonalDev
ENVIRONMENT=personal-dev
PUBLIC_ALB=true
ALLOW_PUBLIC_HTTP=false
ACM_CERT_ARN=
DOMAIN_NAME=ams-dev.getshaking.live
HOSTED_ZONE_ID=Z077931918WPQT6KQ24A9
HOSTED_ZONE_NAME=getshaking.live
# No real JIRA in this account — the synthetic seed stands in for the sync.
JIRA_SYNC_ENABLED=false
# Cost: let Aurora pause after 15 idle minutes (min 0 ACU; ~15 s resume).
AURORA_AUTO_PAUSE_MINUTES=15
# Set to 0 to park the environment (stops the API task; ALB still bills).
API_DESIRED_COUNT=1
# Customer Portal (Phase 1+): customer Cognito pool + portal.<DOMAIN_NAME>.
PORTAL_ENABLED=true
PORTAL_STAFF_EMAIL_DOMAINS=imt.ca
# Customer emails stay off here: the seeded users are fictional. To try a
# real send, verify an SES identity and set PORTAL_EMAIL_FROM to it.
# PORTAL_EMAIL_FROM=
